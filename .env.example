# Paste your Otari key here (otari.ai -> API keys -> Create key).
# Tick "Service key" under Advanced to get per-user budgets.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1

# Each role names an Otari routing policy. If a policy doesn't exist yet,
# the app calls the *_BACKUP model directly, so it works either way.
DOCTOR_GATE_MODEL=openai/gpt-oss-safeguard-120b
DOCTOR_GATE_BACKUP=openai/gpt-oss-20b
DOCTOR_EXPLORER_MODEL=doctor-explorer
DOCTOR_EXPLORER_BACKUP=deepseek/deepseek-v4.1-flash-1017
DOCTOR_TESTER_MODEL=doctor-tester
DOCTOR_TESTER_BACKUP=openai/gpt-oss-120b
DOCTOR_REPORTER_MODEL=doctor-reporter
DOCTOR_REPORTER_BACKUP=z-ai/glm-5.3-flash

# MCP: leave empty to use DeepWiki + GitMCP inline (needs "Let requests name
# their own MCP servers" on), or paste the ids of servers added in Tools -> MCP servers.
OTARI_MCP_SERVER_IDS=

# Optional: a guardrail profile mandated in Organization -> Guardrails.
OTARI_GUARDRAIL_PROFILE=
OTARI_GUARDRAIL_MODE=monitor

DOCTOR_WEB_FETCH=1
PORT=3000
